                    "text": "jit.gl.texture @type float32"
                }
            },
            {
                "box": {
                    "code": "Param speed(50);\r\nParam amt(0.9);\r\n\r\nnoiseIn = in1;\r\npicIn = in2;\r\nfbIn = in3;\r\n\r\npixel = 1 / dim;\r\n\r\nspeedOffset = sample(fbIn, norm + vec(0, 1) * pixel);\r\nspeedOffset *= clip(norm.y, 0.5, 1);\r\n\r\nctrl = clip(picIn, 0.25, 1);\r\n\r\n\r\nmove = norm - vec(0, pixel) * speed * speedOffset * ctrl;\r\nneighbour = nearest(fbIn, move, boundmode = \"clamp\");\r\n\r\n\r\npic = mix(neighbour, picIn, 1 - amt);\r\n\r\n\r\nmask = pixel.y > norm.y;\r\n\r\n\r\nout1 = mix(pic, noiseIn, mask);\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-19",
                    "maxclass": "jit.gl.pix.codebox",
                    "numinlets": 3,
                    "numoutlets": 2,
                    "outlettype": [ "jit_gl_texture", "" ],
                    "patching_rect": [ 438.0, 297.0, 559.0, 453.0 ]
                }
            },
            {
